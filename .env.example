# =============================================================================
#  Variables d'environnement — Respusse (France ↔ Congo)
# =============================================================================
#  Copiez ce fichier en `.env.local` puis remplacez chaque valeur.
#  `.env.local` est ignoré par Git : aucune clé ne doit jamais être commitée.
#
#  Rappel de sécurité : seules les variables préfixées NEXT_PUBLIC_ sont
#  envoyées au navigateur. Toutes les autres restent côté serveur.
# =============================================================================


# -----------------------------------------------------------------------------
#  Site
# -----------------------------------------------------------------------------

# URL publique du site, sans slash final.
# Sert aux balises canoniques, à l'Open Graph, au sitemap.xml et au robots.txt.
# En local : http://localhost:3000 — en production : https://votre-domaine.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
#  Supabase — base de données, authentification et stockage des images
#  Où trouver ces valeurs : dashboard Supabase > Project Settings > API
# -----------------------------------------------------------------------------

# URL du projet Supabase, de la forme https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé « anon / publishable ». Elle est publique par conception : la sécurité
# repose sur les politiques RLS définies dans supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Clé « service_role ». SECRÈTE — elle contourne toutes les politiques RLS.
# Utilisée uniquement côté serveur pour enregistrer les messages du formulaire
# de contact (les visiteurs n'ont donc aucun droit d'écriture direct en base).
# Ne la préfixez JAMAIS par NEXT_PUBLIC_ et ne la déposez jamais dans le code.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# Nom du bucket Supabase Storage qui accueille les photos des projets et les
# images de couverture des articles. À créer en public depuis le dashboard.
NEXT_PUBLIC_SUPABASE_BUCKET=medias


# -----------------------------------------------------------------------------
#  Resend — envoi de l'e-mail de notification du formulaire de contact
#  Où trouver cette valeur : https://resend.com/api-keys
# -----------------------------------------------------------------------------

# Clé API Resend. SECRÈTE. Commence par « re_ ».
# Si elle est absente, le message est tout de même enregistré en base : seule la
# notification par e-mail est ignorée (avec un avertissement dans les logs).
RESEND_API_KEY=re_votre_cle_resend

# Adresse expéditrice des notifications. Le domaine doit être vérifié dans
# Resend, sinon l'envoi est refusé. En phase de test, Resend accepte
# « onboarding@resend.dev ».
RESEND_FROM_EMAIL="Respusse <contact@votre-domaine.fr>"

# Adresse (ou adresses, séparées par des virgules) qui reçoivent les messages
# envoyés depuis le formulaire de contact.
CONTACT_NOTIFICATION_EMAIL=vous@votre-domaine.fr
